# Raw data - never commit, always regenerated via scripts/
data/raw/*
!data/raw/.gitkeep
*.parquet
*.h5
*.rds
!results/**/*.parquet

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# R
.Rhistory
.RData
.Rproj.user/

# OS
.DS_Store

# Results that are large or regeneratable
results/figures/*.pdf

# TCGAbiolinks downloads its cache here relative to wherever it's run
GDCdata/
MANIFEST.txt
